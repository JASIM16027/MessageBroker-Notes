flowchart TB
  subgraph ROW1[" "]
    direction LR
    subgraph DIRECT["Direct Exchange"]
      direction TB
      D_P["Publish, routing key = 'error'"] --> D_E{{Exchange}}
      D_E -->|"key = 'error'"| D_Q1["Queue: errors"]
      D_E -.->|"key = 'info' (no match)"| D_Q2["Queue: info"]
    end
    subgraph FANOUT["Fanout Exchange"]
      direction TB
      F_P["Publish (routing key ignored)"] --> F_E{{Exchange}}
      F_E --> F_Q1["Queue: A"]
      F_E --> F_Q2["Queue: B"]
      F_E --> F_Q3["Queue: C"]
    end
  end

  subgraph ROW2[" "]
    direction LR
    subgraph TOPIC["Topic Exchange"]
      direction TB
      T_P["Publish, key = 'order.dhaka.created'"] --> T_E{{Exchange}}
      T_E -->|"binding: order.dhaka.*"| T_Q1["Queue: dhaka-orders"]
      T_E -->|"binding: order.#"| T_Q2["Queue: all-orders"]
    end
    subgraph HEADERS["Headers Exchange"]
      direction TB
      H_P["Publish, headers: type=pdf, urgent=true"] --> H_E{{Exchange}}
      H_E -->|"match headers"| H_Q1["Queue: urgent-pdf"]
    end
  end

  style DIRECT fill:#e3f2fd,stroke:#1565c0
  style FANOUT fill:#e8f5e9,stroke:#2e7d32
  style TOPIC fill:#fff3e0,stroke:#ef6c00
  style HEADERS fill:#f3e5f5,stroke:#6a1b9a
  style ROW1 fill:none,stroke:none
  style ROW2 fill:none,stroke:none
